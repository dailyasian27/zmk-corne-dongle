#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 46 47 45>;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 34 42 43 44>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "GALLIUM";
            bindings = <
&kp TAB  &kp Z            &kp L            &kp D         &kp C         &kp B                                 &kp UP                &kp J    &kp Y               &kp O         &kp U             &kp SEMICOLON  &kp CAPSLOCK
&td0     &HML LEFT_WIN N  &HML LEFT_ALT R  &HML LCTRL S  &HML LSHFT T  &kp G                       &kp LEFT  &kp ENTER  &kp RIGHT  &kp P    &HMR RIGHT_SHIFT H  &HMR RCTRL E  &HMR RIGHT_ALT A  &HMR RGUI I    &kp SQT
&kp ESC  &kp X            &kp Q            &kp M         &lt 1 W       &kp V          &kp SPACE              &kp DOWN              &kp K    &lt 4 F             &kp COMMA     &kp DOT           &kp FSLH       &kp RG(L)
                                           &kp DEL       &lt 1 ENTER   &kp BACKSPACE                                               &kp TAB  &lt 2 SPACE         &tog 3
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        NUMBER {
            display-name = "NUMBER";
            bindings = <
&trans  &none       &kp HOME        &kp UP_ARROW    &kp END          &none                                  &mmv MOVE_UP                     &kp ASTERISK  &kp N7        &kp N8        &kp N9        &kp SLASH   &kp BSPC
&trans  &kp ENTER   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp TAB                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp PLUS      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &none
&trans  &kp ESCAPE  &kp LC(LS(V))   &kp LC(C)       &kp LC(V)        &none    &kp C_MUTE                    &mmv MOVE_DOWN                   &kp EQUAL     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &none
                                    &trans          &trans           &trans                                                                  &kp ENTER     &kp N0        &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        SYMBOL {
            display-name = "SYMBOL";
            bindings = <
&trans  &none      &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES     &kp PERIOD                             &mmv MOVE_UP                     &kp AMPS   &kp RIGHT_BRACKET      &kp LEFT_BRACKET      &kp UNDER   &kp PERCENT   &kp BSPC
&trans  &kp EXCL   &kp MINUS      &kp PLUS          &kp EQUAL             &kp POUND              &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp PIPE   &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS  &kp SQT     &kp QUESTION  &none
&trans  &kp CARET  &kp SLASH      &kp STAR          &kp NON_US_BACKSLASH  &kp PERCENT  &trans                    &mmv MOVE_DOWN                   &kp TILDE  &kp RIGHT_BRACE        &kp LBRC              &kp DOLLAR  &kp AT        &none
                                  &trans            &trans                &kp SPACE                                                               &kp RET    &trans                 &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        GAME {
            display-name = "GAME";
            bindings = <
&kp ESC  &kp Q  &kp W  &kp E      &kp R      &kp T                                       &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&kp TAB  &kp A  &kp S  &kp D      &kp F      &kp G                       &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&kp P    &kp Z  &kp X  &kp C      &kp V      &kp B         &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                       &kp LCTRL  &kp SPACE  &kp LEFT_ALT                                                                 &tog 0       &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        NAV {
            display-name = "NUMBER";
            bindings = <
&trans  &none       &kp HOME        &kp UP_ARROW    &kp END          &none                                  &mmv MOVE_UP                     &none      &none         &kp N8        &kp N9        &kp SLASH   &kp BSPC
&trans  &kp ENTER   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp TAB                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp PLUS   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &none
&trans  &kp ESCAPE  &kp LC(LS(V))   &kp LC(C)       &kp LC(V)        &none    &kp C_MUTE                    &mmv MOVE_DOWN                   &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &none
                                    &trans          &trans           &trans                                                                  &kp ENTER  &kp N0        &trans
            >;

            sensor-bindings = <&rsr_vol>, <&rsr_trans>;
        };
    };
};
